#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1
NAME=autonomy-api
DAEMON=/usr/local/libexec/autonomy-api/autonomy-api.lua
PIDFILE=/var/run/autonomy-api.pid

start_service() {
    mkdir -p /var/log/autonomy-api
    
    procd_open_instance
    procd_set_param command lua "$DAEMON"
    procd_set_param respawn 10 5 60
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f "$PIDFILE"
}

status() {
    if [ -f "$PIDFILE" ]; then
        local pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "running"
            return 0
        fi
    fi
    echo "not running"
    return 1
}
