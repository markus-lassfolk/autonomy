{
    "luci-app-autonomy": {
        "description": "Grant access to Autonomy configuration",
        "read": {
            "ubus": {
                "service": ["list", "get"],
                "system": ["info"]
            },
            "uci": ["autonomy"]
        },
        "write": {
            "ubus": {
                "service": ["add", "delete", "restart"],
                "system": ["reboot"]
            },
            "uci": ["autonomy"]
        }
    }
}





