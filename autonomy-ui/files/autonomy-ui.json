    "autonomy-ui": {
        "description": "Autonomy Web UI access",
        "read": {
            "ubus": {
                "autonomy": ["status", "interfaces", "predictions"],
                "starlink_tracker": ["status", "predictions", "satellites"]
            }
        },
        "write": {
