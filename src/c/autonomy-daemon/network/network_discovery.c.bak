#include "network_discovery.h"
#include "../shared/logging/logx.h"
#include "../core/types.h"
#include "../shared/utils/string_utils.h"
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <net/if.h>
#include <sys/ioctl.h>
#include <pthread.h>
#include <time.h>
#include <dirent.h>
#include <uci.h>
#include <sys/stat.h>

// External reference to global configuration
extern autonomy_config_t g_config;

// Forward declarations
void* discovery_monitor_thread_func(void *arg\n"\n"\n"\n");
static void discover_system_interfaces(void\n"\n"\n"\n");
static void discover_uci_interfaces(void\n"\n"\n"\n");
static void get_interface_details(network_interface_t *iface\n"\n"\n"\n");
static void determine_interface_type(network_interface_t *interface\n"\n"\n"\n");
static void get_interface_statistics(network_interface_t *interface\n"\n"\n"\n");
static void cleanup_stale_interfaces(time_t now\n"\n"\n"\n");
static bool interface_exists_in_system(const char *interface_name\n"\n"\n"\n");

// Network discovery configuration - now uses UCI config values
// Configuration values are loaded from g_config (UCI system)
#define LOCAL_LOCAL_MAX_INTERFACES 32            // Maximum interfaces to track
static const char* INTERFACE_TYPES[] = {
    "ethernet", "wifi", "cellular", "vpn", "bridge", "vlan", "tunnel"
};

// Global discovery state
static network_discovery_t g_discovery = {0};
static pthread_mutex_t g_discovery_mutex = PTHREAD_MUTEX_INITIALIZER;
static bool g_discovery_initialized = false;
static pthread_t g_discovery_thread = 0;
static bool g_discovery_thread_running = false;

// Initialize network discovery system
int network_discovery_init(void) {
    if (g_discovery_initialized) {
        printf("WARN: "Network discovery already initialized"\n"\n"\n"\n");
        return AUTONOMY_SUCCESS;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    // Initialize discovery state
    memset(&g_discovery, 0, sizeof(network_discovery_t)\n"\n"\n"\n");
    g_discovery.enabled = true; // Use configurable network discovery enabled
    g_discovery.discovery_interval = g_config.network_check_interval;
    g_discovery.interface_timeout = 300; // Use configurable timeout
    g_discovery.max_interfaces = MAX_INTERFACES;
    g_discovery.last_discovery = 0;
    g_discovery.total_discoveries = 0;
    g_discovery.interface_count = 0;
    
    g_discovery_initialized = true;
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    printf("INFO: "Network discovery system initialized successfully"\n"\n"\n"\n");
    return AUTONOMY_SUCCESS;
}

// Start network discovery monitoring thread
int network_discovery_start_monitoring(void) {
    if (!g_discovery_initialized) {
        printf("ERROR: "Network discovery not initialized"\n"\n"\n"\n");
        return AUTONOMY_ERROR_NOT_INITIALIZED;
    }
    
    if (g_discovery_thread_running) {
        printf("WARN: "Network discovery monitoring already running"\n"\n"\n"\n");
        return AUTONOMY_SUCCESS;
    }
    
    // Create monitoring thread
    int ret = pthread_create(&g_discovery_thread, NULL, discovery_monitor_thread_func, NULL\n"\n"\n"\n");
    if (ret != 0) {
        printf("ERROR: "Failed to create network discovery monitoring thread"\n"\n"\n"\n");
        return AUTONOMY_ERROR_SYSTEM;
    }
    
    g_discovery_thread_running = true;
    printf("INFO: "Network discovery monitoring started"\n"\n"\n"\n");
    
    return AUTONOMY_SUCCESS;
}

// Stop network discovery monitoring
void network_discovery_stop_monitoring(void) {
    if (!g_discovery_thread_running) {
        return;
    }
    
    g_discovery_thread_running = false;
    
    if (g_discovery_thread != 0) {
        pthread_join(g_discovery_thread, NULL\n"\n"\n"\n");
        g_discovery_thread = 0;
    }
    
    printf("INFO: "Network discovery monitoring stopped"\n"\n"\n"\n");
}

// Network discovery monitoring thread
void* discovery_monitor_thread_func(void *arg) {
    (void)arg;
    
    printf("INFO: "Network discovery monitoring thread started"\n"\n"\n"\n");
    
    while (g_discovery_thread_running) {
        // Perform network discovery
        network_discovery_scan_interfaces(\n"\n"\n"\n");
        
        // Sleep for discovery interval
        for (int i = 0; i < g_discovery.discovery_interval && g_discovery_thread_running; i++) {
            sleep(1\n"\n"\n"\n");
        }
    }
    
    printf("INFO: "Network discovery monitoring thread stopped"\n"\n"\n"\n");
    return NULL;
}

// Scan for available network interfaces
int network_discovery_scan_interfaces(void) {
    if (!g_discovery_initialized) {
        return AUTONOMY_ERROR_NOT_INITIALIZED;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    time_t now = time(NULL\n"\n"\n"\n");
    
    // Check if it's time to discover
    if (g_discovery.last_discovery > 0 && 
        (now - g_discovery.last_discovery) < g_discovery.discovery_interval) {
        pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
        return AUTONOMY_SUCCESS;
    }
    
    printf("DEBUG: "Starting network interface discovery"\n"\n"\n"\n");
    
    // Discover system interfaces
    discover_system_interfaces(\n"\n"\n"\n");
    
    // Discover UCI network interfaces
    discover_uci_interfaces(\n"\n"\n"\n");
    
    // Clean up stale interfaces
    cleanup_stale_interfaces(now\n"\n"\n"\n");
    
    g_discovery.last_discovery = now;
    g_discovery.total_discoveries++;
    
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    printf("DEBUG: "Network interface discovery completed, found %d interfaces", g_discovery.interface_count\n"\n"\n"\n");
    return AUTONOMY_SUCCESS;
}

// Discover system network interfaces
static void discover_system_interfaces(void) {
    struct if_nameindex *if_ni, *i;
    
    if_ni = if_nameindex(\n"\n"\n"\n");
    if (if_ni == NULL) {
        printf("ERROR: "Failed to get interface names"\n"\n"\n"\n");
        return;
    }
    
    for (i = if_ni; i->if_index != 0 || i->if_name != NULL; i++) {
        if (g_discovery.interface_count >= g_discovery.max_interfaces) {
            printf("WARN: "Maximum interface count reached, skipping %s", i->if_name\n"\n"\n"\n");
            break;
        }
        
        // Check if interface already exists
        bool exists = false;
        for (int j = 0; j < g_discovery.interface_count; j++) {
            if (strcmp(g_discovery.interfaces[j].name, i->if_name) == 0) {
                exists = true;
                // Update last seen time
                g_discovery.interfaces[j].last_seen = time(NULL\n"\n"\n"\n");
                break;
            }
        }
        
        if (!exists) {
            // Add new interface
            network_interface_t *iface = &g_discovery.interfaces[g_discovery.interface_count];
            memset(iface, 0, sizeof(network_interface_t)\n"\n"\n"\n");
            
            safe_strncpy(iface->name, i->if_name, sizeof(iface->name)\n"\n"\n"\n");
            iface->index = i->if_index;
            iface->last_seen = time(NULL\n"\n"\n"\n");
            iface->discovered = true;
            
            // Get interface details
            get_interface_details(iface\n"\n"\n"\n");
            
            g_discovery.interface_count++;
            
            printf("DEBUG: "Discovered interface: %s (index: %d)", iface->name, iface->index\n"\n"\n"\n");
        }
    }
    
    if_freenameindex(if_ni\n"\n"\n"\n");
}

// Discover UCI network interfaces using real UCI integration
static void discover_uci_interfaces(void) {
    // Use UCI to discover configured network interfaces
    struct uci_context *ctx = uci_alloc_context(\n"\n"\n"\n");
    if (!ctx) {
        printf("ERROR: "Failed to allocate UCI context for network discovery"\n"\n"\n"\n");
        return;
    }
    
    struct uci_package *pkg = NULL;
    int ret = uci_load(ctx, "network", &pkg\n"\n"\n"\n");
    if (ret != UCI_OK || !pkg) {
        printf("ERROR: "Failed to load UCI network package"\n"\n"\n"\n");
        uci_free_context(ctx\n"\n"\n"\n");
        return;
    }
    
    // Iterate through UCI network sections
    struct uci_element *e;
    uci_foreach_element(&pkg->sections, e) {
        if (g_discovery.interface_count >= g_discovery.max_interfaces) {
            break;
        }
        
        struct uci_section *s = uci_to_section(e\n"\n"\n"\n");
        const char *type = uci_lookup_option_string(ctx, s, "type"\n"\n"\n"\n");
        const char *ifname = uci_lookup_option_string(ctx, s, "ifname"\n"\n"\n"\n");
        const char *device = uci_lookup_option_string(ctx, s, "device"\n"\n"\n"\n");
        
        // Only process interface sections
        if (type && strcmp(type, "interface") == 0 && ifname) {
            // Check if interface already exists
            bool exists = false;
            for (int j = 0; j < g_discovery.interface_count; j++) {
                if (strcmp(g_discovery.interfaces[j].name, ifname) == 0) {
                    exists = true;
                break;
            }
        }
        
            if (!exists) {
                // Check if interface actually exists in system
                if (interface_exists_in_system(ifname)) {
                    network_interface_t *iface = &g_discovery.interfaces[g_discovery.interface_count];
                    memset(iface, 0, sizeof(network_interface_t)\n"\n"\n"\n");
                    
                    safe_strncpy(iface->name, ifname, sizeof(iface->name)\n"\n"\n"\n");
                    iface->last_seen = time(NULL\n"\n"\n"\n");
                    iface->discovered = true;
                    
                    // Get UCI configuration details
                    const char *proto = uci_lookup_option_string(ctx, s, "proto"\n"\n"\n"\n");
                    const char *ipaddr = uci_lookup_option_string(ctx, s, "ipaddr"\n"\n"\n"\n");
                    const char *netmask = uci_lookup_option_string(ctx, s, "netmask"\n"\n"\n"\n");
                    const char *gateway = uci_lookup_option_string(ctx, s, "gateway"\n"\n"\n"\n");
                    
                    if (proto) {
                        safe_strncpy(iface->protocol, proto, sizeof(iface->protocol)\n"\n"\n"\n");
                    }
                    if (ipaddr) {
                        safe_strncpy(iface->ip_address, ipaddr, sizeof(iface->ip_address)\n"\n"\n"\n");
                    }
                    if (netmask) {
                        safe_strncpy(iface->netmask, netmask, sizeof(iface->netmask)\n"\n"\n"\n");
                    }
                    if (gateway) {
                        safe_strncpy(iface->gateway, gateway, sizeof(iface->gateway)\n"\n"\n"\n");
                    }
                    if (device) {
                        safe_strncpy(iface->device, device, sizeof(iface->device)\n"\n"\n"\n");
                    }
                    
                    // Get additional interface details
                    get_interface_details(iface\n"\n"\n"\n");
                    
                    g_discovery.interface_count++;
                    
                    printf("DEBUG: "Discovered UCI interface",
                                  "name", iface->name,
                                  "protocol", iface->protocol,
                                  "ip", iface->ip_address,
                                  "device", iface->device\n"\n"\n"\n");
                }
            }
        }
    }
    
    uci_unload(ctx, pkg\n"\n"\n"\n");
    uci_free_context(ctx\n"\n"\n"\n");
    
    // Fallback: Check for common interfaces if UCI discovery found none
    if (g_discovery.interface_count == 0) {
        printf("WARN: "No interfaces found via UCI, using fallback discovery"\n"\n"\n"\n");
        
        const char* common_interfaces[] = {
            "eth0", "eth1", "wlan0", "wlan1", "wwan0", "wwan1", "tun0", "vpn0"
        };
        
        for (int i = 0; i < sizeof(common_interfaces) / sizeof(common_interfaces[0]); i++) {
            if (g_discovery.interface_count >= g_discovery.max_interfaces) {
                break;
            }
            
            // Check if interface already exists
            bool exists = false;
            for (int j = 0; j < g_discovery.interface_count; j++) {
                if (strcmp(g_discovery.interfaces[j].name, common_interfaces[i]) == 0) {
                    exists = true;
                    break;
                }
            }
            
            if (!exists) {
                // Check if interface actually exists in system
                if (interface_exists_in_system(common_interfaces[i])) {
                    network_interface_t *iface = &g_discovery.interfaces[g_discovery.interface_count];
                    memset(iface, 0, sizeof(network_interface_t)\n"\n"\n"\n");
                    
                    safe_strncpy(iface->name, common_interfaces[i], sizeof(iface->name)\n"\n"\n"\n");
                    iface->last_seen = time(NULL\n"\n"\n"\n");
                    iface->discovered = true;
                    
                    // Get interface details
                    get_interface_details(iface\n"\n"\n"\n");
                    
                    g_discovery.interface_count++;
                    
                    printf("DEBUG: "Discovered fallback interface: %s", iface->name\n"\n"\n"\n");
                }
            }
        }
    }
}

// Check if interface exists in system
static bool interface_exists_in_system(const char *interface_name) {
    if (!interface_name) {
        return false;
    }
    
    // Try to get interface flags
    struct ifreq ifr;
    int sock = socket(AF_INET, SOCK_DGRAM, 0\n"\n"\n"\n");
    if (sock < 0) {
        return false;
    }
    
    memset(&ifr, 0, sizeof(ifr)\n"\n"\n"\n");
    strncpy(ifr.ifr_name, interface_name, IFNAMSIZ - 1\n"\n"\n"\n");
    
    if (ioctl(sock, SIOCGIFFLAGS, &ifr) == 0) {
        close(sock\n"\n"\n"\n");
        return true;
    }
    
    close(sock\n"\n"\n"\n");
    return false;
}

// Get detailed interface information
static void get_interface_details(network_interface_t *iface) {
    if (!iface) {
        return;
    }
    
    // Get interface flags and status
    struct ifreq ifr;
    int sock = socket(AF_INET, SOCK_DGRAM, 0\n"\n"\n"\n");
    if (sock < 0) {
        return;
    }
    
    memset(&ifr, 0, sizeof(ifr)\n"\n"\n"\n");
    strncpy(ifr.ifr_name, iface->name, IFNAMSIZ - 1\n"\n"\n"\n");
    
    // Get interface flags
    if (ioctl(sock, SIOCGIFFLAGS, &ifr) == 0) {
        iface->up = (ifr.ifr_flags & IFF_UP) != 0;
        iface->enabled = (ifr.ifr_flags & IFF_UP) != 0;
    }
    
    // Get interface address
    if (ioctl(sock, SIOCGIFADDR, &ifr) == 0) {
        struct sockaddr_in *addr = (struct sockaddr_in*)&ifr.ifr_addr;
        inet_ntop(AF_INET, &addr->sin_addr, iface->ip_address, sizeof(iface->ip_address)\n"\n"\n"\n");
    }
    
    // Get interface netmask
    if (ioctl(sock, SIOCGIFNETMASK, &ifr) == 0) {
        struct sockaddr_in *addr = (struct sockaddr_in*)&ifr.ifr_netmask;
        inet_ntop(AF_INET, &addr->sin_addr, iface->netmask, sizeof(iface->netmask)\n"\n"\n"\n");
    }
    
    // Get interface MAC address
    if (ioctl(sock, SIOCGIFHWADDR, &ifr) == 0) {
        unsigned char *mac = (unsigned char*)ifr.ifr_hwaddr.sa_data;
        snprintf(iface->mac_address, sizeof(iface->mac_address),
                "%02x:%02x:%02x:%02x:%02x:%02x",
                mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]\n"\n"\n"\n");
    }
    
    // Get interface MTU
    if (ioctl(sock, SIOCGIFMTU, &ifr) == 0) {
        iface->mtu = ifr.ifr_mtu;
    }
    
    close(sock\n"\n"\n"\n");
    
    // Determine interface type
    determine_interface_type(iface\n"\n"\n"\n");
    
    // Get interface statistics
    get_interface_statistics(iface\n"\n"\n"\n");
}

// Determine interface type based on name and characteristics
static void determine_interface_type(network_interface_t *iface) {
    if (!iface) {
        return;
    }
    
    // Check interface name patterns
    if (strncmp(iface->name, "eth", 3) == 0) {
        safe_strncpy(iface->type, "ethernet", sizeof(iface->type)\n"\n"\n"\n");
    } else if (strncmp(iface->name, "wlan", 4) == 0) {
        safe_strncpy(iface->type, "wifi", sizeof(iface->type)\n"\n"\n"\n");
    } else if (strncmp(iface->name, "wwan", 4) == 0) {
        safe_strncpy(iface->type, "cellular", sizeof(iface->type)\n"\n"\n"\n");
    } else if (strncmp(iface->name, "tun", 3) == 0 || strncmp(iface->name, "tap", 3) == 0) {
        safe_strncpy(iface->type, "vpn", sizeof(iface->type)\n"\n"\n"\n");
    } else if (strncmp(iface->name, "br", 2) == 0) {
        safe_strncpy(iface->type, "bridge", sizeof(iface->type)\n"\n"\n"\n");
    } else if (strncmp(iface->name, "vlan", 4) == 0) {
        safe_strncpy(iface->type, "vlan", sizeof(iface->type)\n"\n"\n"\n");
    } else {
        safe_strncpy(iface->type, "unknown", sizeof(iface->type)\n"\n"\n"\n");
    }
}

// Get interface statistics
static void get_interface_statistics(network_interface_t *iface) {
    if (!iface) {
        return;
    }
    
    // Read interface statistics from /proc/net/dev
    char path[256];
    snprintf(path, sizeof(path), "/proc/net/dev"\n"\n"\n"\n");
    
    FILE *fp = fopen(path, "r"\n"\n"\n"\n");
    if (!fp) {
        return;
    }
    
    char line[512];
    // Skip header lines
    fgets(line, sizeof(line), fp\n"\n"\n"\n");
    fgets(line, sizeof(line), fp\n"\n"\n"\n");
    
    while (fgets(line, sizeof(line), fp)) {
        char ifname[32];
        unsigned long rx_bytes, tx_bytes, rx_packets, tx_packets;
        unsigned long rx_errors, tx_errors, rx_dropped, tx_dropped;
        
        // Parse line: interface rx_bytes rx_packets rx_errors rx_dropped tx_bytes tx_packets tx_errors tx_dropped ...
        if (sscanf(line, "%31s %lu %lu %lu %lu %lu %lu %lu %lu",
                   ifname, &rx_bytes, &rx_packets, &rx_errors, &rx_dropped,
                   &tx_bytes, &tx_packets, &tx_errors, &tx_dropped) >= 8) {
            
            // Remove colon from interface name
            char *colon = strchr(ifname, ':'\n"\n"\n"\n");
            if (colon) *colon = '\0';
            
            if (strcmp(ifname, iface->name) == 0) {
                iface->rx_bytes = rx_bytes;
                iface->tx_bytes = tx_bytes;
                iface->rx_packets = rx_packets;
                iface->tx_packets = tx_packets;
                iface->rx_errors = rx_errors;
                iface->tx_errors = tx_errors;
                iface->rx_dropped = rx_dropped;
                iface->tx_dropped = tx_dropped;
                break;
            }
        }
    }
    
    fclose(fp\n"\n"\n"\n");
}

// Clean up stale interfaces
static void cleanup_stale_interfaces(time_t now) {
    for (int i = 0; i < g_discovery.interface_count; i++) {
        if (g_discovery.interfaces[i].last_seen > 0 &&
            (now - g_discovery.interfaces[i].last_seen) > g_discovery.interface_timeout) {
            
            printf("DEBUG: "Removing stale interface: %s", g_discovery.interfaces[i].name\n"\n"\n"\n");
            
            // Remove interface by shifting remaining interfaces
            for (int j = i; j < g_discovery.interface_count - 1; j++) {
                memcpy(&g_discovery.interfaces[j], &g_discovery.interfaces[j + 1], sizeof(network_interface_t)\n"\n"\n"\n");
            }
            g_discovery.interface_count--;
            i--; // Recheck this index
        }
    }
}

// Get discovered interfaces
int network_discovery_get_interfaces(network_interface_t *interfaces, int max_count, int *actual_count) {
    if (!g_discovery_initialized || !interfaces || !actual_count) {
        return AUTONOMY_ERROR_INVALID_PARAM;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    *actual_count = 0;
    int count = (g_discovery.interface_count < max_count) ? g_discovery.interface_count : max_count;
    
    for (int i = 0; i < count; i++) {
        memcpy(&interfaces[i], &g_discovery.interfaces[i], sizeof(network_interface_t)\n"\n"\n"\n");
        (*actual_count)++;
    }
    
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    return AUTONOMY_SUCCESS;
}

// Get interface by name
int network_discovery_get_interface(const char *interface_name, network_interface_t *interface) {
    if (!g_discovery_initialized || !interface_name || !interface) {
        return AUTONOMY_ERROR_INVALID_PARAM;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    for (int i = 0; i < g_discovery.interface_count; i++) {
        if (strcmp(g_discovery.interfaces[i].name, interface_name) == 0) {
            memcpy(interface, &g_discovery.interfaces[i], sizeof(network_interface_t)\n"\n"\n"\n");
            pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
            return AUTONOMY_SUCCESS;
        }
    }
    
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    return AUTONOMY_ERROR_NOT_FOUND;
}

// Get discovery status
int network_discovery_get_status(network_discovery_status_t *status) {
    if (!g_discovery_initialized || !status) {
        return AUTONOMY_ERROR_INVALID_PARAM;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    status->enabled = g_discovery.enabled;
    status->discovery_interval = g_discovery.discovery_interval;
    status->interface_timeout = g_discovery.interface_timeout;
    status->max_interfaces = g_discovery.max_interfaces;
    status->last_discovery = g_discovery.last_discovery;
    status->total_discoveries = g_discovery.total_discoveries;
    status->interface_count = g_discovery.interface_count;
    
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    return AUTONOMY_SUCCESS;
}

// Set discovery configuration
int network_discovery_set_config(const network_discovery_config_t *config) {
    if (!g_discovery_initialized || !config) {
        return AUTONOMY_ERROR_INVALID_PARAM;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    
    if (config->discovery_interval > 0) {
        g_discovery.discovery_interval = config->discovery_interval;
    }
    
    if (config->interface_timeout > 0) {
        g_discovery.interface_timeout = config->interface_timeout;
    }
    
    if (config->max_interfaces > 0) {
        g_discovery.max_interfaces = config->max_interfaces;
    }
    
    g_discovery.enabled = config->enabled;
    
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    printf("INFO: "Network discovery configuration updated"\n"\n"\n"\n");
    return AUTONOMY_SUCCESS;
}

// Enable/disable discovery system
int network_discovery_set_enabled(bool enabled) {
    if (!g_discovery_initialized) {
        return AUTONOMY_ERROR_NOT_INITIALIZED;
    }
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    g_discovery.enabled = enabled;
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    printf("INFO: "Network discovery system %s", enabled ? "enabled" : "disabled"\n"\n"\n"\n");
    return AUTONOMY_SUCCESS;
}

// Force immediate discovery
int network_discovery_force_scan(void) {
    if (!g_discovery_initialized) {
        return AUTONOMY_ERROR_NOT_INITIALIZED;
    }
    
    printf("INFO: "Forcing immediate network discovery"\n"\n"\n"\n");
    return network_discovery_scan_interfaces(\n"\n"\n"\n");
}

// Cleanup discovery system
void network_discovery_cleanup(void) {
    if (!g_discovery_initialized) {
        return;
    }
    
    // Stop monitoring thread
    network_discovery_stop_monitoring(\n"\n"\n"\n");
    
    pthread_mutex_lock(&g_discovery_mutex\n"\n"\n"\n");
    g_discovery_initialized = false;
    pthread_mutex_unlock(&g_discovery_mutex\n"\n"\n"\n");
    
    pthread_mutex_destroy(&g_discovery_mutex\n"\n"\n"\n");
    
    printf("INFO: "Network discovery system cleaned up"\n"\n"\n"\n");
}
