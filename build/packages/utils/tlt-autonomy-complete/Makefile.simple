include $(TOPDIR)/rules.mk

PKG_NAME:=tlt-autonomy-complete
PKG_VERSION:=5.8.4
PKG_RELEASE:=273

PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)

include $(INCLUDE_DIR)/package.mk

define Package/tlt-autonomy-complete
  SECTION:=utils
  CATEGORY:=Utilities
  TITLE:=Telia Autonomy Complete System
  DEPENDS:=+libcurl +libjson-c +libubox +libubus +libuci +mwan3 +libsqlite3 +uhttpd +uhttpd-mod-ubus
endef

define Package/tlt-autonomy-complete/description
  Complete Telia Autonomy Network Management System
endef

define Build/Prepare
	$(INSTALL_DIR) $(PKG_BUILD_DIR)
	$(CP) -r $(CURDIR)/../../../../src/c/autonomy-daemon/* $(PKG_BUILD_DIR)/
	$(INSTALL_DIR) $(PKG_BUILD_DIR)/ui
	$(CP) -r $(CURDIR)/../../../../src/web/autonomy-ui/* $(PKG_BUILD_DIR)/ui/
endef

define Build/Compile
	$(MAKE) -C $(PKG_BUILD_DIR) \
		CC="$(TARGET_CC)" \
		CFLAGS="$(TARGET_CFLAGS) -I$(STAGING_DIR)/usr/include" \
		LDFLAGS="$(TARGET_LDFLAGS) -L$(STAGING_DIR)/usr/lib"
	
	# Process UI files
	$(INSTALL_DIR) $(PKG_BUILD_DIR)/ui/processed
	$(CP) $(PKG_BUILD_DIR)/ui/enhanced-autonomy-dashboard.html $(PKG_BUILD_DIR)/ui/processed/index.html || true
	$(CP) $(PKG_BUILD_DIR)/ui/ml-analytics-dashboard.html $(PKG_BUILD_DIR)/ui/processed/ml-analytics.html || true
	$(CP) $(PKG_BUILD_DIR)/ui/autonomy-dashboard.js $(PKG_BUILD_DIR)/ui/processed/autonomy-dashboard.js || true
endef

define Package/tlt-autonomy-complete/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/autonomy-daemon $(1)/usr/bin/ || true
	
	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/files/autonomy.init $(1)/etc/init.d/autonomy || true
	
	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/files/autonomy.config $(1)/etc/config/autonomy || true
	
	$(INSTALL_DIR) $(1)/www/autonomy
	$(CP) $(PKG_BUILD_DIR)/ui/processed/index.html $(1)/www/autonomy/ || true
	$(CP) $(PKG_BUILD_DIR)/ui/processed/ml-analytics.html $(1)/www/autonomy/ || true
	$(CP) $(PKG_BUILD_DIR)/ui/processed/autonomy-dashboard.js $(1)/www/autonomy/ || true
endef

$(eval $(call BuildPackage,tlt-autonomy-complete))
