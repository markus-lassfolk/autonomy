config autonomy 'global'
    option enabled '1'
    option log_level 'info'
    option debug_mode '0'
    option config_file '/etc/autonomy/autonomy.conf'

config starlink 'tracking'
    option enabled '1'
    option api_key ''
    option update_interval '300'
    option timeout '30'

config cellular 'backup'
    option enabled '1'
    option failover_threshold '3'
    option recovery_threshold '2'
    option check_interval '60'

config notifications 'system'
    option enabled '1'
    option email_enabled '0'
    option sms_enabled '0'
    option webhook_enabled '0'
    option pushover_enabled '0'
    option slack_enabled '0'
    option discord_enabled '0'
    option telegram_enabled '0'
